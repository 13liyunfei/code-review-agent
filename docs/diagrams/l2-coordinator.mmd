flowchart TD
    S["Coordinator.review(pullRequest)"] --> T["runId = TraceContext.ensure<br/>runId 与 traceId 统一"]
    T --> RC["轨迹记录器 begin<br/>append review.started<br/>append context.diff-loaded"]

    RC --> RS{"断点续跑：<br/>resumeStore 存在同 runId 快照?"}
    RS -->|"命中"| RS1["加载 ResumeState<br/>已完成 Agent 结果直接复用<br/>只重跑剩余 Agent"]
    RS -->|"未命中"| RS2["全部 Agent 待执行"]
    RS1 --> IA
    RS2 --> IA

    IA["ImpactAnalyzer.summarize<br/>变更方法的上游调用方"] --> RAG["RagContextBuilder.buildContext<br/>团队规范 / 历史知识检索"]
    RAG --> ENR["合并为 enrichedCtx<br/>withImpactSummary + withRagContext"]

    ENR --> CA{"customAgentStore<br/>有启用中的自定义 Agent?"}
    CA -->|"是"| CA1["展开 DeclarativeReviewAgent<br/>按 teamId 隔离，与内置 Agent 并行"]
    CA -->|"否 / 异常"| CA2["仅 5 个内置 Agent<br/>异常时降级不阻断"]
    CA1 --> PL
    CA2 --> PL

    PL{"review.planning.enabled?"}
    PL -->|"开"| PL1["TaskPlanningSupport.planAndExecute<br/>LLM 拆解子任务 DAG，按依赖拓扑并行"]
    PL -->|"关 / 规划失败"| PL2["固定并行路径"]

    PL1 --> MR["合并已产出结果"]
    PL2 --> FU["为每个 Agent 创建 CompletableFuture<br/>TraceContext.wrap 保证 traceId 跨线程"]
    FU --> ADV["并行：AdvancedAnalyzer<br/>AST 结构 / 调用图影响面 / SCA 依赖"]

    MR --> DL
    ADV --> DL["计算共享 deadline<br/>now + review.agent.timeout-ms（默认 300000ms）"]

    DL --> GT["逐个 future.get(remaining)<br/>剩余时间随 deadline 递减"]
    GT --> GT1{"结果如何?"}
    GT1 -->|"正常返回"| GT2["收集 AgentResult<br/>saveCheckpoint 写断点快照"]
    GT1 -->|"TimeoutException"| GT3["future.cancel(true) 中断底层线程<br/>AgentResult.degraded + AgentDegradation"]
    GT1 -->|"其他异常"| GT4["rootMessage 解包根因<br/>标记 degraded"]

    GT2 --> ADV2{"advancedFuture 限时等待"}
    GT3 --> ADV2
    GT4 --> ADV2
    ADV2 -->|"超时 / 异常"| ADV3["cancel(true)<br/>STAGE_ADVANCED_ANALYSIS 降级留痕"]
    ADV2 -->|"正常"| ADV4["并入 results"]
    ADV3 --> AGG
    ADV4 --> AGG

    AGG["ReportGenerator.aggregate<br/>去重 → 仲裁 → 抑制 → 分级统计"] --> CUS{"有自定义 Agent 参与?"}
    CUS -->|"是"| CUS1["report.withCustomAgents 署名"]
    CUS -->|"否"| VP
    CUS1 --> VP

    VP["VetoPolicy.apply<br/>从抑制/覆盖中回收 BLOCKER 强否决"] --> PF["ReviewProfile 过滤<br/>STRICT / ADVISORY / SUGGEST"]
    PF --> VER["computeVerification<br/>与上轮对比：已解决 / 未解决 / 新引入"]
    VER --> HS["historyStore.save 落地审查历史"]
    HS --> CP["resumeStore.complete 清理断点"]
    CP --> TP["轨迹记录 review.completed 并 close"]
    TP --> R(["返回 ReviewReport"])

    classDef start fill:#2c7d2c,stroke:#2c7d2c,stroke-width:2px,color:#fff;
    classDef endn fill:#1f2933,stroke:#1f2933,stroke-width:2px,color:#fff;
    classDef proc fill:#FFFFFF,stroke:#2c7d2c,stroke-width:1px,color:#1f2933;
    classDef dec fill:#FFF7ED,stroke:#b45309,stroke-width:1px,color:#7c3d0b;
    classDef warn fill:#FEF2F2,stroke:#b91c1c,stroke-width:1px,color:#991b1b;
    classDef enhance fill:#EEF2FF,stroke:#1d4ed8,stroke-width:1px,color:#1e3a8a;
    class S start;
    class R endn;
    class T,RC,IA,RAG,ENR,MR,FU,ADV,DL,GT,CUS1,VER,HS,CP,TP proc;
    class RS,CA,PL,GT1,ADV2,CUS dec;
    class GT3,GT4,ADV3,RS1 warn;
    class PL1,CA1,RAG,IA,VP,PF enhance;
