flowchart TD
    A["输入：AgentResult 列表<br/>含自定义 Agent + AdvancedAnalyzer 结果"] --> D0

    D0["⓪ 降级收集<br/>Agent 级 degraded 标记 + 基础设施级 degradations<br/>按 stage 去重，写入报告告警块"] --> D1

    D1["① 去重<br/>dedupKey = 文件 @ 行区间 # 规则"] --> D2{"同键冲突?"}
    D2 -->|"新 Finding 更严重<br/>或同级但置信度更高"| D3["替换保留"]
    D2 -->|"否则"| D4["保留原条目"]
    D3 --> AR
    D4 --> AR

    AR["② 优先级仲裁<br/>ArbitrationPolicy.isConflict 判定"] --> AR1{"是否冲突?<br/>不同 Agent + 同文件 + 行区间重叠 + 建议文本不同"}
    AR1 -->|"否"| AR2["全部保留"]
    AR1 -->|"是"| AR3["winner 裁决：<br/>先比 Agent 权重 → 再比严重度 → 最后比置信度"]
    AR3 --> AR4["落败方移入 overriddenFindings<br/>并生成仲裁说明 note"]
    AR2 --> FP
    AR4 --> FP

    FP["③ 误报抑制<br/>feedbackStore.falsePositives(teamId)"] --> FP1{"命中历史误报?"}
    FP1 -->|"是"| FP2["移入 suppressedFindings"]
    FP1 -->|"否"| FP3["进入 kept 保留列表"]
    FP2 --> ST
    FP3 --> ST

    ST["④ 分级统计<br/>BLOCKER / MAJOR / MINOR / INFO 计数"] --> OUT["输出 ReviewReport<br/>findings + suppressed + overridden + arbitrationNotes + degradations"]

    OUT --> VT{"VetoPolicy：BLOCKER 是否被<br/>误报抑制 / 仲裁覆盖?"}
    VT -->|"是"| VT1["回收 BLOCKER 回到 findings<br/>强否决不可被覆盖"]
    VT -->|"否"| PF
    VT1 --> PF

    PF{"ReviewProfile 强度"}
    PF -->|"STRICT 严格"| PF1["仅剔除 INFO"]
    PF -->|"ADVISORY 建议（默认）"| PF2["只保留 BLOCKER + MAJOR"]
    PF -->|"SUGGEST 仅建议"| PF3["全部保留"]
    PF1 --> FIN(["最终对外发现列表"])
    PF2 --> FIN
    PF3 --> FIN

    classDef start fill:#2c7d2c,stroke:#2c7d2c,stroke-width:2px,color:#fff;
    classDef endn fill:#1f2933,stroke:#1f2933,stroke-width:2px,color:#fff;
    classDef proc fill:#FFFFFF,stroke:#2c7d2c,stroke-width:1px,color:#1f2933;
    classDef dec fill:#FFF7ED,stroke:#b45309,stroke-width:1px,color:#7c3d0b;
    classDef drop fill:#FEF2F2,stroke:#b91c1c,stroke-width:1px,color:#991b1b;
    classDef keep fill:#F0FDF4,stroke:#15803d,stroke-width:1px,color:#14532d;
    class A start;
    class FIN endn;
    class D0,D1,AR,FP,ST,OUT proc;
    class D2,AR1,FP1,VT,PF dec;
    class AR4,FP2,D0 drop;
    class AR2,FP3,PF1,PF2,PF3,VT1 keep;
