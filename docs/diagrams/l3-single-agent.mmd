flowchart TD
    A["agent.review(diffs, enrichedCtx)"] --> B{"① 输入防护<br/>InjectionDetector"}

    B -->|"命中注入模式"| B1["上报 BLOCKER<br/>SEC-INJECTION-001"]
    B1 --> B2(["短路返回<br/>不进 LLM"])

    B -->|"干净"| C["② Skill 预扫描<br/>registry 按 teamId + 分类取技能<br/>parallelStream 并行执行"]
    C --> D["SkillResult → Finding<br/>按 ruleId 历史准确率校准置信度"]

    D --> G["③ LLM 增强<br/>模板注入影响面 + RAG 上下文"]
    G --> H{"优先：AiServices<br/>结构化输出 + ChatMemory"}
    H -->|"成功且非空"| H1["映射为 Finding<br/>来源 LLM"]

    H -->|"失败 / 空"| I{"次选：agent-kit<br/>类型推导 schema"}
    I -->|"成功"| I1["映射为 Finding<br/>来源 LLM"]
    I -->|"结构化失败<br/>但原文非空"| J["复用原始输出做文本解析<br/>不再多调一次模型"]
    I -->|"彻底失败"| K["askLlm 文本对话<br/>解析器兜底"]

    H1 --> M
    I1 --> M
    J --> M
    K --> M
    M["合并 Skill 发现 + LLM 发现"] --> N(["返回 Finding 列表"])

